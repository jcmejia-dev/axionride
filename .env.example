# Supabase Project URL from Project Settings > API (or the Connect dialog).
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Supabase publishable key (legacy projects may label this the anon key). Never use a service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
